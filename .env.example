# FraudShield AI Environment Variables Template

# Application Environment
ENVIRONMENT=development

# Database Connection URL
# Default (Local Development): sqlite:///./fraudshield.db
# Serverless Vercel (Production Persistent DB): postgresql://user:password@ep-sample-123456.us-east-1.aws.neon.tech/fraudshield?sslmode=require
DATABASE_URL=sqlite:///./fraudshield.db

# Frontend API URL Base (Optional in production — defaults to same origin /api)
# NEXT_PUBLIC_API_URL=https://fraudshield.vercel.app

# Private API Keys & Model Thresholds
XGB_WEIGHT=0.60
IFOREST_WEIGHT=0.40
LOW_THRESHOLD=39.0
MEDIUM_THRESHOLD=69.0
